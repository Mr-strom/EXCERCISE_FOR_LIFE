<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Live Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/livePreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Visual Skeleton Overlay View -->
    <com.example.cvassessment.app.ui.PoseOverlayView
        android:id="@+id/livePoseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. UI Controls and Telemetry Layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Exercise Name -->
            <TextView
                android:id="@+id/tvLiveExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Push-Up"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <!-- Validation Status Chip -->
            <TextView
                android:id="@+id/chipValidationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#4CAF50"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="TRACKING"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rep Counter & Completed Rep Metrics Card (Left) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#CC0D0D0D"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvRepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPS"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvRepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <!-- Completed rep metrics: shown only when a rep completes (no per-frame spam) -->
            <TextView
                android:id="@+id/tvCompletedRepMetrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#81C784"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- INSUFFICIENT_VISIBILITY Banner: brief, non-alarming, single actionable line matching Screen 2 -->
        <LinearLayout
            android:id="@+id/bannerInsufficientVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#D9C62828"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvInsufficientMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Can't see you clearly — step back a bit"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-time Active Feedback Overlay Banner -->
        <TextView
            android:id="@+id/tvLiveFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CCFF9800"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- Vertical Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 2. Position Guidance Messages (subtle, bottom of screen) -->
        <LinearLayout
            android:id="@+id/llPositionGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#B3111111"
            android:padding="8dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvPositionGuidanceIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvPositionGuidance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full body visible"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnLiveFlipCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flip"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEndSession"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:backgroundTint="#D32F2F"
                android:text="End Session"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingLeft="24dp"
                android:paddingRight="24dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
