<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Live Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/livePreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Visual Skeleton Overlay View -->
    <com.example.cvassessment.app.ui.PoseOverlayView
        android:id="@+id/livePoseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. UI Controls and Telemetry Layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Exercise Name -->
            <TextView
                android:id="@+id/tvLiveExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Push-Up"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <!-- Validation Status Chip -->
            <TextView
                android:id="@+id/chipValidationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#4CAF50"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="TRACKING"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Large Rep Counter Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#CC000000"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPS"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstantRom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROM: --"
                android:textColor="#81C784"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- INSUFFICIENT_VISIBILITY Banner (R10.2: Must be clearly visible when active) -->
        <LinearLayout
            android:id="@+id/bannerInsufficientVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6D32F2F"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="20sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Can't see you clearly — adjust your position."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-time Active Feedback Overlay Banner -->
        <TextView
            android:id="@+id/tvLiveFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CCFF9800"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- Vertical Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnLiveFlipCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flip"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEndSession"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:backgroundTint="#D32F2F"
                android:text="End Session"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingLeft="24dp"
                android:paddingRight="24dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
