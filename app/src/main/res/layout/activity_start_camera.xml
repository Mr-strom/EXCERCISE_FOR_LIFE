<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Live Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/startCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible" />

    <!-- 2. Clean Guided Setup & Controls Layer -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Top Header & Lens Switcher -->
        <LinearLayout
            android:id="@+id/llTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#CC0A0A0A"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStartExerciseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push-Up"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraSetupSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera Setup &amp; Calibration"
                    android:textColor="#81C784"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch to Rear"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Center: Stylized Stickman Visual Indicator & Single Actionable Message -->
        <LinearLayout
            android:id="@+id/cardSetupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#CC111111"
            android:padding="20dp">

            <!-- Stickman Visual Indicator (Center) -->
            <com.example.cvassessment.app.ui.StickmanIndicatorView
                android:id="@+id/stickmanView"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginBottom="12dp" />

            <!-- Circular Progress & Live Countdown (Visible during 7s analysis) -->
            <LinearLayout
                android:id="@+id/llAnalyzingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/progressCircular"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvAnalyzingCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzing setup... 7s"
                    android:textColor="#FFB74D"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Result Icon (✓ or ⚠️, visible after analysis) -->
            <TextView
                android:id="@+id/tvResultIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#00E676"
                android:textSize="26sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <!-- Single Human-Readable Headline Message -->
            <TextView
                android:id="@+id/tvStatusHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stand still, we're analyzing your setup..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Actionable Subtitle Tip -->
            <TextView
                android:id="@+id/tvStatusTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep your full body visible in the frame"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Bottom Controls & Guidance Section -->
        <LinearLayout
            android:id="@+id/llBottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- Camera Error Panel (Hidden by default) -->
            <LinearLayout
                android:id="@+id/panelCameraError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E6800020"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Camera is unavailable or permission denied."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnRetryCamera"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Retry Camera" />

                    <Button
                        android:id="@+id/btnOpenSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open Settings"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Secondary Framing Guidance Note (smaller, less prominent) -->
            <TextView
                android:id="@+id/tvFramingGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#80000000"
                android:padding="8dp"
                android:text="Side view most accurate for elbow angle. Ensure whole body is visible."
                android:textColor="#999999"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnReanalyze"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:text="Re-check"
                    android:textSize="14sp"
                    android:backgroundTint="#424242"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnStartExercise"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="Analyzing (7s)..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
